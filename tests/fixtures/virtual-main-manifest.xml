<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_QUIET_MODE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="Virtual Main"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="vmui" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Test door for the scripted checks. Left out of release builds. -->
        <activity android:name=".DevActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".HostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the processes of a virtual phone" />
        </service>

        <!-- Private space (managed work profile). Both sides live in this package. -->
        <!-- Its own process: one Slint screen per process. -->
        <activity android:name=".space.SpaceActivity" android:exported="true" android:launchMode="singleTop"
            android:process=":space" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="vmui" />
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
        </activity>

        <!-- Off by default so the normal home screen shows one app; the private
             space switches it on for itself (Space.ensureEntry). -->
        <activity android:name=".space.SpaceHome" android:exported="true" android:label="Space"
            android:enabled="false" android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="vmui" />
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".space.Comply" android:exported="true" android:directBootAware="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service android:name=".space.SpaceService" android:exported="false" android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="loopback kill listener for the private space" />
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
        </service>

        <receiver android:name=".space.Admin" android:exported="true" android:directBootAware="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".space.Events" android:exported="true" android:directBootAware="true">
            <meta-data android:name="mobilesentinel.lib" android:value="vmui" />
            <intent-filter>
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

{{GUEST_SERVICES}}
    </application>
</manifest>
