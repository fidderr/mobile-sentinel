target/
# Gradle module build output. In a consumer build, build_sentinel passes
# -PsentinelBuildRoot=<consumer-project>/sentinel-build, so output lands in the
# consumer's (writable) project, not here. In workspace/path-dependency dev
# (no property), each module falls back to android/builds/ — ignored here.
android/builds/
android/.gradle/
sentinel/
android/ci-check/.gradle/
android/ci-check/.kotlin/
android/ci-check/build/
# Gradle output inside the Android modules (an IDE's own Gradle run, or a
# build without -PsentinelBuildRoot). Scoped to android/: src/build/ is code.
android/**/build/
android/**/.gradle/
android/**/.kotlin/
