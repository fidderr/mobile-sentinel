<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Exact-alarm components. Merged into the consumer manifest by Gradle
        ONLY when this module is a dependency (the `exact-alarm` firing
        sub-feature is enabled). A non-scheduling consumer ships none of these.

        SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM are injected per the registry's
        `exact_alarm` row by build_sentinel. RECEIVE_BOOT_COMPLETED is declared
        here because the boot receiver lives in this module.

        Class names are fully-qualified to the actual Kotlin package
        (`com.mobilesentinel`), NOT relative — a relative `.Name` would resolve
        against this module's Gradle namespace (`com.mobilesentinel.exactalarm`),
        where the classes do not live.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Exact-alarm wake receiver — activates the job file + starts the
             guardian. Runs in :sentinel. -->
        <receiver
            android:name="com.mobilesentinel.SentinelAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:process=":sentinel">
            <intent-filter>
                <action android:name="com.mobilesentinel.ALARM_DISPATCH" />
            </intent-filter>
        </receiver>

        <!-- Runs the app's core without UI when alarms may have to be armed
             again, or a ring started with MAIN down. In MAIN, where Rust runs. -->
        <receiver
            android:name="com.mobilesentinel.SentinelRearmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Boot completed receiver — replays what was armed after reboot. Runs
             in :sentinel because it starts the job guardian, which must not live
             in MAIN (some OEMs, e.g. ColorOS, hold BOOT_COMPLETED back until
             the user opens the app, so MAIN is often already up). -->
        <receiver
            android:name="com.mobilesentinel.SentinelBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:process=":sentinel"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
